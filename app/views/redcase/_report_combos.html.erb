<table>
	<tr>
		<td>
			<%= l('redcase.label_version') %>:
		</td>
		<td>
			<%=
				select_tag(
					:versionx,
					options_from_collection_for_select(
						Version.where({ project_id: @project.id }),
						'id',
						'name',
						@version.id
					),
					:style => 'width: 225px',
					:class => 'report_combo'
				) if @version
				# TODO: If this view is called with no project version provided,
				#       we need to make sure that it will not crash. This
				#       partial view should not be executed when there is no
				#       project version, so we still need to revise why it
				#       happens in some cases.
			%>
		</td>
	</tr>
	<tr>
		<td>
			<%= l('redcase.label_execution_suite') %>:
		</td>
		<td>
			<%=
				select_tag(
					:suite,
					options_for_select([[l('redcase.label_all'), '-1']]) +
					options_for_select(
						ExecutionSuite.where(project_id: @project.id).map { |suite| [redcase_suite_label(suite), suite.id] },
						get_id_or_default(@root_execution_suite, -1)
					),
					:style => 'width: 225px',
					:class => 'report_combo'
				)
			%>
		</td>
	</tr>
	<tr>
		<td>
			<%= l('redcase.label_environment') %>:
		</td>
		<td>
			<%=
				select_tag(
					:environment,
					options_from_collection_for_select(
						ExecutionEnvironment.where({project_id: @project.id}),
						'id',
						'name',
						@environment.id
					),
					:style => 'width: 225px',
					:class => 'report_combo'
				)
			%>
		</td>
	</tr>
</table>
