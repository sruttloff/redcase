<!-- Loading execution suites for project every time when this form is reloading -->
<% @lists = ExecutionSuite.where({project_id: @project.id}) %>
<!-- AJAX form to manage execution suites -->
<%=
	form_for(
		:list,
		:remote => true,
		:url => {
			:controller => 'redcase/executionsuites',
			:action => 'update',
			:project_id => @project.id
		},
		:update => :management_execution_suites_id,
		:complete => 'Redcase.full()',
		:html => { :id => 'list_form' }
	) do |f|
%>
	<h3>
        <%= l('redcase.label_execution_suite') %>:
		<%= f.select :id, @lists.collect { |e| [redcase_suite_label(e), e.id, {'data-name' => e.name}] } %>
    </h3>
    <p>
        <%= f.text_field :name %>
		<a href="#" id="btn_save_exec_suite" title="<%= l('redcase.label_save_execution_suite') %>" aria-label="<%= l('redcase.label_save_execution_suite') %>">
			<%=
				image_tag(
					'save.png',
					:plugin => 'redcase',
					:size=> '20x20',
					:style => 'vertical-align: middle'
				)
			%>
		</a>
		<a href="#" id="btn_create_exec_suite" title="<%= l('redcase.label_add_execution_suite') %>" aria-label="<%= l('redcase.label_add_execution_suite') %>">
			<%=
				image_tag(
					'add.jpg',
					:plugin => 'redcase',
					:size=> '13x13',
					:style => 'vertical-align: middle'
				)
			%>
		</a>
<% if @lists.length > 1 %>
		<a href="#" id="btn_destroy_exec_suite" title="<%= l('redcase.label_delete_execution_suite') %>" aria-label="<%= l('redcase.label_delete_execution_suite') %>">
			<%=
				image_tag(
					'delete.jpg',
					:plugin => 'redcase',
					:size=> '13x13',
					:style => 'vertical-align: middle'
				)
			%>
		</a>
<% end %>
    </p>
	<br/>
<% end %>
